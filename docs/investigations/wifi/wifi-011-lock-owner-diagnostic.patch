diff --git a/components/newlib/src/time.c b/components/newlib/src/time.c
index 1f609422..0db4424d 100644
--- a/components/newlib/src/time.c
+++ b/components/newlib/src/time.c
@@ -45,6 +45,80 @@ static int64_t  s_adjtime_total_correction_us;
 
 static _lock_t s_time_lock;
 
+/* WIFI-011 bench instrumentation. Only explicit diagnostic ping calls carry a
+ * source tag or delay. The FreeRTOS hooks run under the time mutex's queue lock.
+ */
+typedef struct {
+    TaskHandle_t task;
+    unsigned line;
+    unsigned hold_ms;
+} wifi011_time_call_t;
+
+typedef struct {
+    wifi011_time_call_t owner;
+    char owner_name[configMAX_TASK_NAME_LEN];
+} wifi011_time_failure_t;
+
+static __thread wifi011_time_call_t s_wifi011_ping_call;
+static wifi011_time_call_t s_wifi011_time_owner;
+static wifi011_time_failure_t s_wifi011_failure[configNUMBER_OF_CORES];
+
+int wifi011_ping_gettimeofday(struct timeval *tv, TaskHandle_t ping_task,
+                             unsigned line, unsigned hold_ms);
+void wifi011_time_mutex_taken(void *mutex, TaskHandle_t owner);
+void wifi011_time_mutex_failed(void *mutex, TaskHandle_t owner);
+void wifi011_report_time_failure(void *mutex);
+
+int wifi011_ping_gettimeofday(struct timeval *tv, TaskHandle_t ping_task,
+                             unsigned line, unsigned hold_ms)
+{
+    s_wifi011_ping_call = (wifi011_time_call_t){ping_task, line, hold_ms};
+    int result = gettimeofday(tv, NULL);
+    s_wifi011_ping_call = (wifi011_time_call_t){0};
+    return result;
+}
+
+void IRAM_ATTR wifi011_time_mutex_taken(void *mutex, TaskHandle_t owner)
+{
+    if (mutex != (void *)s_time_lock) {
+        return;
+    }
+    s_wifi011_time_owner = (wifi011_time_call_t){.task = owner};
+    if (s_wifi011_ping_call.task == owner) {
+        s_wifi011_time_owner = s_wifi011_ping_call;
+    }
+}
+
+void IRAM_ATTR wifi011_time_mutex_failed(void *mutex, TaskHandle_t owner)
+{
+    if (mutex != (void *)s_time_lock) {
+        return;
+    }
+    wifi011_time_failure_t *failure = &s_wifi011_failure[xPortGetCoreID()];
+    failure->owner = (wifi011_time_call_t){.task = owner};
+    if (owner && s_wifi011_time_owner.task == owner) {
+        failure->owner = s_wifi011_time_owner;
+    }
+    const char *name = owner ? pcTaskGetName(owner) : "";
+    unsigned i = 0;
+    for (; i < sizeof(failure->owner_name) - 1 && name[i]; i++) {
+        failure->owner_name[i] = name[i];
+    }
+    failure->owner_name[i] = '\0';
+}
+
+void IRAM_ATTR wifi011_report_time_failure(void *mutex)
+{
+    if (mutex != (void *)s_time_lock) {
+        return;
+    }
+    const wifi011_time_failure_t *failure = &s_wifi011_failure[xPortGetCoreID()];
+    esp_rom_printf("WIFI011 mutex=s_time_lock waiter=%s owner=%s owner_handle=%p "
+                   "ping_sock_line=%u forced_hold_ms=%u\n",
+                   pcTaskGetName(NULL), failure->owner_name, failure->owner.task,
+                   failure->owner.line, failure->owner.hold_ms);
+}
+
 // This function gradually changes boot_time to the correction value and immediately updates it.
 static uint64_t adjust_boot_time(void)
 {
@@ -90,6 +164,10 @@ static uint64_t adjust_boot_time(void)
 static uint64_t get_adjusted_boot_time(void)
 {
     _lock_acquire(&s_time_lock);
+    if (xPortCanYield() && s_wifi011_ping_call.hold_ms) {
+        /* Deliberately keep the mutex held while other tasks can run. */
+        vTaskDelay(pdMS_TO_TICKS(s_wifi011_ping_call.hold_ms));
+    }
     uint64_t adjust_time = adjust_boot_time();
     _lock_release(&s_time_lock);
     return adjust_time;
